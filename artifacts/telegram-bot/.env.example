# ─── Bot ──────────────────────────────────────────────────────────────────────
BOT_TOKEN=your_bot_token_from_botfather
BOT_USERNAME=your_bot_username_without_@

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs who have admin access
ADMIN_IDS=123456789,987654321

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/telegram_bot

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Rewards ──────────────────────────────────────────────────────────────────
DAILY_REWARD_POINTS=10
REFERRAL_BONUS_POINTS=50
BONUS_POINTS_PER_ORDER_AMOUNT=10

# ─── Limits ───────────────────────────────────────────────────────────────────
MAX_CART_ITEMS=20
ITEMS_PER_PAGE=8
BROADCAST_DELAY_MS=100
ABANDONED_CART_HOURS=24

# ─── Webhook (production only) ────────────────────────────────────────────────
# Set WEBHOOK_DOMAIN to your domain to enable webhook mode (recommended for production)
# Leave empty to use polling mode (good for development)
# WEBHOOK_DOMAIN=https://yourdomain.com
# WEBHOOK_PORT=3000
