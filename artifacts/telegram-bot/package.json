    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "@prisma/client": "^5.22.0",
    "ioredis": "^5.3.2",
    "bull": "^4.16.3",
