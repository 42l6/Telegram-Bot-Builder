    "zod": "^3.23.8",
    "winston": "^3.17.0",
    "dotenv": "^16.4.7",
    "csv-writer": "^1.6.0",
    "date-fns": "^3.6.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "~5.9.3",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/bull": "^4.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0"
  }
